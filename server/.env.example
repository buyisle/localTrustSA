MONGO_URI=mongodb://127.0.0.1:27017/localtrustsa
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=5001
CLIENT_ORIGIN=http://localhost:5174

# preview generates an in-app receipt without SMTP. Leave unset to disable delivery.
DEMO_RECEIPT_MODE=preview
# Set mode to smtp only for authorized external delivery.
# DEMO_SMTP_HOST=smtp.your-provider.example
# DEMO_SMTP_PORT=587
# DEMO_SMTP_USER=
# DEMO_SMTP_PASS=
# DEMO_SMTP_FROM=

# Server-only key for the text assistant.
OPENAI_API_KEY=

# Booking updates default to in-app previews. Set smtp to use the DEMO_SMTP_* transport.
BOOKING_EMAIL_MODE=preview
